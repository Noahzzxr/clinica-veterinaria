# Copie para .env e ajuste.

# Banco. O padrão abaixo é o PostgreSQL embutido de desenvolvimento (npm run db).
DATABASE_URL="postgresql://vet:vet@localhost:54329/vet"

# Endereço público do site (sitemap, robots, dados estruturados).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp (Cloud API da Meta). Sem estas variáveis, as mensagens ficam na fila.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# E-mail (Resend).
RESEND_API_KEY=
EMAIL_REMETENTE=
